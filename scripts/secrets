#!/usr/bin/env bash
#
# One credentials file, three destinations. Taken from stewards, which took it
# from mass-intentions, and cut down to what this project has: no rehearsal
# instance and no webhook.
#
# secrets.env holds everything this project needs. Which group a value is in
# decides where it goes, and that is a security decision rather than a filing
# one:
#
#   DEPLOY_*  -> GitHub Actions secrets. CI needs them to reach the server.
#   APP_*     -> GitHub Actions variables. Hostnames, paths, a port; not secret.
#   runtime   -> the server's config.toml, over ssh, from a person's machine.
#
# The third group never passes through GitHub: the mail relay's password, if it
# has one, and the one-time bootstrap secret that makes somebody the site
# administrator.
#
# Run by a person, never by an agent (CLAUDE.md section 6). Every command that
# reads the real secrets.env is reached through a `make deploy-*` target, and
# .claude/settings.json denies both those and this script to agents.
set -euo pipefail

REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
SECRETS_ENV="${SECRETS_ENV:-$REPO_DIR/secrets.env}"

log()  { printf '\033[1m==>\033[0m %s\n' "$*"; }
warn() { printf '\033[33m !!\033[0m %s\n' "$*" >&2; }
ok()   { printf '\033[32m  ok\033[0m %s\n' "$*"; }
bad()  { printf '\033[31m   X\033[0m %s\n' "$*"; }
die()  { printf '\033[31mX\033[0m %s\n' "$*" >&2; exit 1; }

require() { command -v "$1" >/dev/null 2>&1 || die "$1 is required but is not installed"; }

# Which key belongs to which destination. This list IS the policy, so it is
# written out rather than inferred from a prefix -- a new secret added to
# secrets.env and not named here goes nowhere, loudly, which is the safe
# direction to fail.
DEPLOY_KEYS=(DEPLOY_SSH_HOST DEPLOY_SSH_USER DEPLOY_SSH_PORT DEPLOY_SSH_KEY_B64 DEPLOY_KNOWN_HOSTS_B64)
VAR_KEYS=(APP_HOST APP_PORT APP_DIR APP_DOCROOT KEEP_BACKUPS)
RUNTIME_KEYS=(BOOTSTRAP_SIGNIN_SECRET SMTP_HOST SMTP_PORT SMTP_USER SMTP_PASSWORD MAIL_FROM MAIL_FROM_NAME)

REQUIRED=(DEPLOY_SSH_HOST DEPLOY_SSH_USER DEPLOY_SSH_PORT DEPLOY_SSH_KEY_B64 DEPLOY_KNOWN_HOSTS_B64 APP_HOST APP_PORT APP_DIR APP_DOCROOT)

# load reads secrets.env with the shared parser in scripts/env.sh.
# shellcheck source=env.sh
. "$REPO_DIR/scripts/env.sh"

load() {
	[ -f "$SECRETS_ENV" ] || die "there is no $SECRETS_ENV. Copy secrets.env.example to secrets.env and fill it in"
	parse_env "$SECRETS_ENV"
}

b64()   { base64 -w0 2>/dev/null || base64 | tr -d '\n'; }
unb64() { base64 -d 2>/dev/null; }

# The deploy key and the pinned host key live in secrets.env, base64-encoded on
# one line each, because a private key is multi-line and this file is
# line-oriented. Encoded, not encrypted: secrets.env is exactly as sensitive as
# the key itself, and lives in Bitwarden for that reason.
#
# materialise decodes both into a directory removed on exit, so nothing is left
# on disk between commands.
#
# The directory and its trap are made here, at the top level, and never inside
# materialise. materialise is reached through $(keyfile), a subshell, and a trap
# set in a subshell fires at its closing parenthesis -- mass-intentions lost an
# evening to a caller handed the path of a file that had just been deleted.
SECRETS_TMP="$(mktemp -d)"
chmod 700 "$SECRETS_TMP"
trap 'rm -rf "$SECRETS_TMP"' EXIT

# materialise reports and returns rather than dying, because check and status
# exist to tell somebody everything that is wrong, not the first thing.
materialise() {
	[ ! -s "$SECRETS_TMP/key" ] || return 0

	if [ -z "${DEPLOY_SSH_KEY_B64:-}" ]; then
		bad "DEPLOY_SSH_KEY_B64 is not set. Run: make deploy-keygen" >&2
		return 1
	fi

	if ! printf '%s' "$DEPLOY_SSH_KEY_B64" | unb64 > "$SECRETS_TMP/key"; then
		bad "DEPLOY_SSH_KEY_B64 is not valid base64. Re-run: make deploy-keygen" >&2
		return 1
	fi
	chmod 600 "$SECRETS_TMP/key"

	if ! grep -q 'BEGIN OPENSSH PRIVATE KEY' "$SECRETS_TMP/key"; then
		bad "DEPLOY_SSH_KEY_B64 decodes to something that is not an ssh private key. Re-run: make deploy-keygen" >&2
		return 1
	fi

	if [ -n "${DEPLOY_KNOWN_HOSTS_B64:-}" ]; then
		if ! printf '%s' "$DEPLOY_KNOWN_HOSTS_B64" | unb64 > "$SECRETS_TMP/known_hosts"; then
			bad "DEPLOY_KNOWN_HOSTS_B64 is not valid base64. Re-run: make deploy-known-hosts" >&2
			return 1
		fi
	else
		: > "$SECRETS_TMP/known_hosts"
	fi

	return 0
}

keyfile()    { printf '%s' "$SECRETS_TMP/key"; }
knownhosts() { printf '%s' "$SECRETS_TMP/known_hosts"; }

# remote runs one command on the server with the pinned host key, the deploy
# key and nothing else: BatchMode so a key that is not installed is a failure
# rather than a password prompt.
remote() {
	ssh -i "$(keyfile)" -p "${DEPLOY_SSH_PORT:-22}" \
		-o "UserKnownHostsFile=$(knownhosts)" -o StrictHostKeyChecking=yes \
		-o BatchMode=yes -o ConnectTimeout=15 \
		"${DEPLOY_SSH_USER}@${DEPLOY_SSH_HOST}" "$@"
}

# Variables are not secret, so a mismatch can show both sides -- and has to,
# because the difference is usually one that cannot be seen: a space, a
# carriage return. %q makes it visible. Never used on a DEPLOY_* value.
shown()      { printf '%q' "$1"; }
live_value() { sed -n "s/^$1=//p" <<<"$2" | head -1; }

# ---------------------------------------------------------------- render

# render prints a config.toml. production is what the server runs; local is
# for `make run` on a developer's machine and never names the server.
#
# The runtime sections are left out entirely when their values are empty,
# rather than written empty. The binary reads an absent [auth] and an empty
# secret the same way, but an empty line in the file invites somebody to fill
# it in on the server, where the next deploy-send-secrets discards it.
cmd_render() {
	local env="${1:-production}"
	load

	# trust_proxy: on the server every request comes through Apache, which
	# writes the visitor's address into X-Forwarded-For; on a developer's
	# machine nothing is in front, and believing the header would let any
	# request choose its own throttle bucket.
	local addr base_url trust_proxy
	case "$env" in
	production)
		addr="127.0.0.1:${APP_PORT:?APP_PORT is not set}"
		base_url="https://${APP_HOST:?APP_HOST is not set}"
		trust_proxy=true
		;;
	local)
		addr="${DEV_ADDR:-127.0.0.1:8461}"
		base_url="${DEV_BASE_URL:-http://$addr}"
		trust_proxy=false
		;;
	*)
		die "render takes production or local, not $env"
		;;
	esac

	cat <<-TOML
		# Written by scripts/secrets. Do not edit on the server: the next
		# make deploy-send-secrets overwrites it, and the edit is lost.
		#
		# Source of truth is secrets.env on a person's machine, which is in
		# Bitwarden. Change it there and run: make deploy-send-secrets

		[server]
		addr = "$(toml "$addr")"
		base_url = "$(toml "$base_url")"
		trust_proxy = $trust_proxy
		shutdown_grace = "15s"

		[log]
		level = "info"
		file = ""
	TOML

	if [ -n "${BOOTSTRAP_SIGNIN_SECRET:-}" ]; then
		cat <<-TOML

			[auth]
			bootstrap_secret = "$(toml "$BOOTSTRAP_SIGNIN_SECRET")"
		TOML
	fi

	if [ -n "${SMTP_HOST:-}" ]; then
		cat <<-TOML

			[mail]
			host = "$(toml "$SMTP_HOST")"
			port = $(port "${SMTP_PORT:-587}")
			user = "$(toml "${SMTP_USER:-}")"
			password = "$(toml "${SMTP_PASSWORD:-}")"
			from = "$(toml "${MAIL_FROM:-}")"
			from_name = "$(toml "${MAIL_FROM_NAME:-Reconcile}")"
		TOML
	fi
}

# toml escapes a value for a TOML basic string. A password is exactly the kind
# of value that holds a quote or a backslash, and unescaped, one
# would end the string early: a config the binary refuses, or worse, one it
# reads differently. Newlines cannot occur; parse_env is line-based.
toml() { printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'; }

# port is written bare, as TOML wants an integer, so it must be one.
port() {
	case "$1" in
	''|*[!0-9]*) die "SMTP_PORT is '$1'; it must be a number: 25 for the host's own mail server, 587 for a relay elsewhere" ;;
	esac
	printf '%s' "$1"
}

# ---------------------------------------------------------------- bootstrap secret

# cmd_bootstrap_secret prints a fresh secret for BOOTSTRAP_SIGNIN_SECRET. It
# reads nothing and writes nothing; the person pastes it into secrets.env.
# 48 characters from the alphanumerics, which is about 285 bits and needs no
# escaping anywhere it goes.
cmd_bootstrap_secret() {
	LC_ALL=C tr -dc 'A-Za-z0-9' < /dev/urandom | head -c 48
	echo
}

# ---------------------------------------------------------------- ssh key

# cmd_ssh_keygen mints the key this project deploys with.
#
# Its own key, not the person's and not mass-intentions' or stewards'. All
# three deploy to the same konsoleH account, so the keys open the same door; a
# key each is still worth it, because revoking one project's key -- a leaked secret, a
# retired repository -- must not break the other's deploys.
#
# ed25519, no passphrase: a passphrase on a key CI must use unattended is a
# passphrase stored next to the key. The private key is never written anywhere
# but a temporary directory this function removes; it exists afterwards only in
# the line printed for secrets.env.
cmd_ssh_keygen() {
	require ssh-keygen
	[ -f "$SECRETS_ENV" ] && load || true

	local tmp; tmp="$(mktemp -d)"
	trap "rm -rf '$tmp'" RETURN

	ssh-keygen -q -t ed25519 -f "$tmp/key" -C "reconcile deploy" -N ""

	log "install this public key on the konsoleH account"
	echo
	cat "$tmp/key.pub"
	echo
	log "then put this line in secrets.env, replacing any DEPLOY_SSH_KEY_B64 already there"
	echo
	printf 'DEPLOY_SSH_KEY_B64=%s\n' "$(b64 < "$tmp/key")"
	echo

	cat <<-NEXT
	    Paste the public key into konsoleH's SSH key settings, or, if you can
	    already reach the account another way:

	        ssh-copy-id -f -i /dev/stdin -p "${DEPLOY_SSH_PORT:-22}" "${DEPLOY_SSH_USER:-USER}@${DEPLOY_SSH_HOST:-HOST}" <<'KEY'
	$(cat "$tmp/key.pub")
	KEY

	    Losing this terminal before saving the line above means minting a new
	    key, which is the right cost for the only copy.

	    Then:

	        make deploy-known-hosts     # pin the server
	        make deploy-status          # see what is still missing

	NEXT
}

# ---------------------------------------------------------------- known-hosts

# cmd_known_hosts fetches the server's host key so that a deploy is pinned to
# one machine rather than to whoever answers DNS that morning.
cmd_known_hosts() {
	load
	require ssh-keyscan

	local host="${DEPLOY_SSH_HOST:?DEPLOY_SSH_HOST is not set}"
	local port="${DEPLOY_SSH_PORT:-22}"

	log "asking $host:$port for its host key"

	local keys
	keys="$(ssh-keyscan -p "$port" -t ed25519,rsa "$host" 2>/dev/null | grep -v '^#' || true)"
	[ -n "$keys" ] || die "$host:$port did not answer with a host key. Is the hostname right, and is ssh open on that port?"

	echo
	printf '%s\n' "$keys" | sed 's/^/    /'
	echo
	log "put this line in secrets.env, replacing any DEPLOY_KNOWN_HOSTS_B64 already there"
	echo
	printf 'DEPLOY_KNOWN_HOSTS_B64=%s\n' "$(printf '%s\n' "$keys" | b64)"
	echo
	warn "you are trusting this fingerprint. Compare it with what konsoleH shows before you paste it"
}

# ---------------------------------------------------------------- the checks

# Each section counts its own problems into PROBLEMS and never exits, so that
# status can run all of them and give one verdict at the end. A readiness
# report that stops at the first gap is a report somebody runs six times.
PROBLEMS=0
problem() { bad "$*"; PROBLEMS=$((PROBLEMS + 1)); }

section_local() {
	log "secrets.env"

	for key in "${REQUIRED[@]}"; do
		if [ -n "${!key:-}" ]; then ok "$key"; else problem "$key is empty"; fi
	done

	# Decoded and inspected, not merely present. The whole point of keeping the
	# key in this file is that it can be checked before a deploy relies on it.
	if materialise 2>/dev/null; then
		local fp
		fp="$(ssh-keygen -y -f "$(keyfile)" 2>/dev/null | ssh-keygen -lf - 2>/dev/null || true)"
		if [ -n "$fp" ]; then
			ok "the deploy key decodes and is usable: $fp"
		else
			problem "DEPLOY_SSH_KEY_B64 decodes but ssh cannot read it as a key. Run: make deploy-keygen"
		fi
	else
		problem "DEPLOY_SSH_KEY_B64 is missing or not valid base64. Run: make deploy-keygen"
	fi

	# The shape is checked, not only the presence. A known_hosts line missing
	# its host field is ignored by ssh, which then fails the deploy with "Host
	# key verification failed" and names neither the file nor the reason.
	local kh; kh="$(knownhosts)"

	if [ ! -s "$kh" ]; then
		problem "DEPLOY_KNOWN_HOSTS_B64 is empty or invalid; a deploy would trust whatever answers. Run: make deploy-known-hosts"
	elif [ "$(awk 'NF && $1 !~ /^#/ {print NF}' "$kh" | sort -u)" != "3" ]; then
		problem "DEPLOY_KNOWN_HOSTS_B64 is not in known_hosts form (host keytype key). Re-run: make deploy-known-hosts"
	else
		# ssh matches on the host as written, so a port that is not 22 must
		# appear as [host]:port or the pin silently never applies.
		local want="${DEPLOY_SSH_HOST:-}"
		[ "${DEPLOY_SSH_PORT:-22}" = "22" ] || want="[${DEPLOY_SSH_HOST:-}]:${DEPLOY_SSH_PORT}"

		if grep -qF "$want " "$kh"; then
			ok "the host key is pinned for $want"
		else
			problem "DEPLOY_KNOWN_HOSTS_B64 pins a different host than $want. Re-run: make deploy-known-hosts"
		fi
	fi

	# The binary's default and the .htaccess template both say 8461. A
	# different port here is not wrong in itself, but it is a third place to
	# keep in step, and the day they drift every page is a 502.
	if [ -n "${APP_PORT:-}" ] && [ "$APP_PORT" != "8461" ]; then
		warn "APP_PORT is $APP_PORT; the binary's default and deploy/README.md say 8461"
	fi

	# The database and config.toml live in APP_DIR. Inside the docroot, Apache
	# would serve them to anybody who asked.
	case "${APP_DIR:-}" in
	"") ;;
	public_html|public_html/*|*/public_html|*/public_html/*|"${APP_DOCROOT:-//}"|"${APP_DOCROOT:-//}"/*)
		problem "APP_DIR ($APP_DIR) is inside public_html, where Apache could serve the database. Put it beside public_html, such as ~/reconcile"
		;;
	*) ok "APP_DIR ($APP_DIR) is outside public_html" ;;
	esac
}

section_github() {
	log "GitHub"

	if ! command -v gh >/dev/null 2>&1; then
		problem "gh is not installed, so GitHub cannot be checked from here"
		return
	fi

	if ! gh auth status >/dev/null 2>&1; then
		problem "gh is not logged in; run gh auth login"
		return
	fi

	local have_secrets live_vars
	have_secrets="$(gh secret list --json name -q '.[].name' 2>/dev/null || true)"
	live_vars="$(gh variable list --json name,value -q '.[] | .name + "=" + .value' 2>/dev/null || true)"

	# A secret's value cannot be read back, so presence is all there is.
	for key in "${DEPLOY_KEYS[@]}"; do
		if grep -qx "$key" <<<"$have_secrets"; then ok "secret $key"; else problem "secret $key is not on GitHub. Run: make deploy-send-secrets"; fi
	done

	# A variable's value CAN be read back, so it is compared rather than
	# counted. In mass-intentions this is what would have caught a repository
	# full of the literal string "-" before CI did.
	for key in "${VAR_KEYS[@]}"; do
		[ -n "${!key:-}" ] || continue

		if grep -qxF "$key=${!key}" <<<"$live_vars"; then
			ok "variable $key matches secrets.env"
		elif grep -q "^$key=" <<<"$live_vars"; then
			problem "variable $key differs: secrets.env says $(shown "${!key}"), GitHub has $(shown "$(live_value "$key" "$live_vars")"). If you ran deploy-send-secrets in the last minute, GitHub may still be catching up; otherwise run it"
		else
			problem "variable $key is not on GitHub. Run: make deploy-send-secrets"
		fi
	done

	for key in "${RUNTIME_KEYS[@]}"; do
		if grep -qx "$key" <<<"$have_secrets"; then
			problem "$key is on GitHub and must not be. Remove it: gh secret delete $key"
		fi
	done
}

# section_server asks the account, over one ssh connection, the facts a first
# deploy depends on. One connection rather than one per question: each is a
# login on a shared account and a second or two of handshake, and six of them
# to answer one question is noise in the account's log and in the wait.
section_server() {
	log "the server"

	if [ ! -s "$(keyfile)" ] || [ ! -s "$(knownhosts)" ] || [ -z "${DEPLOY_SSH_HOST:-}" ] || [ -z "${DEPLOY_SSH_USER:-}" ]; then
		problem "cannot try the server until the deploy credentials above are in place"
		return
	fi

	local dir docroot port
	dir="$(printf '%q' "${APP_DIR:-}")"
	docroot="$(printf '%q' "${APP_DOCROOT:-}")"
	port="$(printf '%q' "${APP_PORT:-}")"

	local out
	if ! out="$(remote "
		echo who=\$(id -un)@\$(hostname)
		[ -d $dir ] && echo dir=yes || echo dir=no
		[ -f $dir/config.toml ] && echo config=yes || echo config=no
		[ -d $docroot ] && echo docroot=yes || echo docroot=no
		[ -f $docroot/.htaccess ] && echo htaccess=yes || echo htaccess=no
		grep -q '127.0.0.1:'$port'/' $docroot/.htaccess 2>/dev/null && echo proxies=yes || echo proxies=no
	" 2>&1)"; then
		case "$out" in
		*"Host key verification failed"*)
			problem "the pinned host key does not match what answered. Re-run: make deploy-known-hosts" ;;
		*"Permission denied"*)
			problem "the server does not accept the deploy key. Install its public half on the account: make deploy-keygen prints it" ;;
		*)
			problem "could not reach ${DEPLOY_SSH_USER}@${DEPLOY_SSH_HOST}: $(printf '%s' "$out" | tail -1)" ;;
		esac
		return
	fi

	fact() { sed -n "s/^$1=//p" <<<"$out"; }

	ok "the deploy key is accepted: $(fact who)"

	if [ "$(fact docroot)" = yes ]; then ok "the docroot $APP_DOCROOT exists"
	else problem "the docroot $APP_DOCROOT does not exist. Add the subdomain in konsoleH with that docroot"; fi

	if [ "$(fact htaccess)" = yes ] && [ "$(fact proxies)" = yes ]; then
		ok ".htaccess proxies to port $APP_PORT"
	elif [ "$(fact htaccess)" = yes ]; then
		problem ".htaccess is there but does not proxy to 127.0.0.1:$APP_PORT. Reinstall it from deploy/htaccess.template (deploy/README.md)"
	else
		problem "there is no .htaccess in the docroot. Install it from deploy/htaccess.template (deploy/README.md)"
	fi

	# Not problems: a first deploy creates both. Reported so that the answer to
	# "has this ever been deployed?" is on the screen.
	if [ "$(fact dir)" = yes ]; then ok "APP_DIR $APP_DIR exists"
	else warn "APP_DIR $APP_DIR does not exist yet; the first deploy will create it"; fi

	if [ "$(fact config)" = yes ]; then ok "config.toml is installed"
	else warn "config.toml is not installed yet; make deploy-send-secrets writes it"; fi
}

# section_public asks the internet, which is the only way to learn what a
# visitor gets: DNS, the certificate and what answers behind Apache.
section_public() {
	log "from outside"

	local host="${APP_HOST:-}"
	if [ -z "$host" ]; then
		problem "APP_HOST is empty, so there is nothing to ask"
		return
	fi

	# `|| true` because an unresolvable name is the answer being asked for,
	# and under pipefail getent's failure would end the script here, before
	# the verdict -- which is how the first version of this section behaved.
	local ip
	ip="$(getent ahostsv4 "$host" 2>/dev/null | awk 'NR==1 {print $1}' || true)"
	if [ -z "$ip" ]; then
		problem "$host does not resolve. Add an A record for it pointing at the konsoleH server"
		return
	fi
	ok "$host resolves to $ip"

	if ! command -v curl >/dev/null 2>&1; then
		problem "curl is not installed, so the certificate and the proxy cannot be checked"
		return
	fi

	# --fail is off: a 502 is an answer worth reading, not a curl failure. A
	# certificate problem is a curl failure, and says so in its message.
	local code err
	if ! code="$(curl -sS -o /dev/null -w '%{http_code}' --max-time 15 "https://$host/healthz" 2>"$SECRETS_TMP/curl.err")"; then
		err="$(tail -1 "$SECRETS_TMP/curl.err")"
		case "$err" in
		*certificate*|*SSL*|*TLS*)
			problem "https://$host has no valid certificate yet. Turn on Let's Encrypt for it in konsoleH: $err" ;;
		*)
			problem "https://$host did not answer: $err" ;;
		esac
		return
	fi

	case "$code" in
	200)     ok "https://$host/healthz answers 200: the app is live" ;;
	502|503) ok "https://$host has a valid certificate and Apache proxies, but nothing answers on the port yet ($code). A first deploy fixes that" ;;
	*)       problem "https://$host/healthz answered $code, which is neither the app nor the proxy waiting for it. Check the docroot and .htaccess" ;;
	esac
}

section_pipeline() {
	log "the deploy pipeline"

	# The static build first, because it is the one thing here that proves
	# something about the code rather than about the plumbing.
	if make -C "$REPO_DIR" --no-print-directory release >/dev/null 2>&1; then
		ok "the release binary builds and is static"
	else
		problem "make release fails; run it to see why"
	fi

	# Presence is not enough: deploy.sh exists from the day it installs the
	# front end, and ships the binary only from the day it has a deploy
	# command. A report that went green on the first would say "a push to
	# main will deploy" about a push that installs one file.
	if [ -e "$REPO_DIR/.github/workflows/deploy.yml" ]; then ok ".github/workflows/deploy.yml"
	else problem ".github/workflows/deploy.yml is not written yet"; fi

	if [ ! -e "$REPO_DIR/deploy/deploy.sh" ]; then
		problem "deploy/deploy.sh is not written yet"
	elif grep -q '^cmd_deploy()' "$REPO_DIR/deploy/deploy.sh"; then
		ok "deploy/deploy.sh ships the binary"
	else
		problem "deploy/deploy.sh installs the front end but does not ship the binary yet"
		warn "until it does, a push to main updates .htaccess and nothing else"
	fi
}

verdict() {
	echo
	if [ "$PROBLEMS" -eq 0 ]; then
		log "ready: a push to main will deploy"
	else
		die "not ready: $PROBLEMS problem(s) above"
	fi
}

# section_runtime is what the app needs to sign anybody in, which is not what
# it needs to deploy: an app with neither still answers /healthz. So an empty
# one is a warning rather than a problem -- except a value the binary on the
# server would refuse, and with it the whole config.toml.
section_runtime() {
	log "sign-in (the app runs without these; nobody can sign in)"

	for key in BOOTSTRAP_SIGNIN_SECRET SMTP_HOST MAIL_FROM; do
		if [ -n "${!key:-}" ]; then ok "$key"; else warn "$key is empty"; fi
	done

	if [ -n "${BOOTSTRAP_SIGNIN_SECRET:-}" ] && [ "${#BOOTSTRAP_SIGNIN_SECRET}" -lt 32 ]; then
		problem "BOOTSTRAP_SIGNIN_SECRET is ${#BOOTSTRAP_SIGNIN_SECRET} characters; the app needs at least 32 and would refuse the config. Run: make bootstrap-secret"
	fi

	if [ -n "${SMTP_HOST:-}" ] && [ -z "${MAIL_FROM:-}" ]; then
		problem "SMTP_HOST is set but MAIL_FROM is empty; the app would refuse the config"
	fi

	if [ "${SMTP_USER:+set}" != "${SMTP_PASSWORD:+set}" ]; then
		problem "only one of SMTP_USER and SMTP_PASSWORD is set; the app needs both or neither and would refuse the config"
	fi
}

# check is the credentials half, and needs no ssh and no internet beyond gh.
cmd_check() {
	load
	section_local
	section_runtime
	section_github
	verdict
}

# status is everything check does, and then asks the server and the internet.
cmd_status() {
	load
	section_local
	section_runtime
	section_github
	section_server
	section_public
	section_pipeline
	verdict
}

# ---------------------------------------------------------------- push

cmd_push() {
	load
	require gh

	# Piped to stdin, never `--body -`. gh reads standard input only when
	# --body is absent; `--body -` stores the literal string "-". That shipped
	# once in mass-intentions and put a dash in all ten values while check
	# passed, because listing secrets returns names and not values.
	set_value() {
		local kind="$1" name="$2" value="$3"

		case "$kind" in
		secret)   printf '%s' "$value" | gh secret set "$name" ;;
		variable) printf '%s' "$value" | gh variable set "$name" ;;
		esac
	}

	# Decoding before sending, so a corrupt value fails here rather than in CI.
	materialise || die "the deploy credentials will not decode; nothing was sent"

	log "sending the deploy group to GitHub secrets"
	for key in "${DEPLOY_KEYS[@]}"; do
		[ -n "${!key:-}" ] || die "$key is empty; run make deploy-status"
		set_value secret "$key" "${!key}"
		ok "$key"
	done

	log "sending the addresses to GitHub variables"
	for key in "${VAR_KEYS[@]}"; do
		if [ -n "${!key:-}" ]; then
			set_value variable "$key" "${!key}"
			ok "$key"
		fi
	done

	# Variables can be read back; secrets cannot. So the half that can be
	# verified is verified, immediately, rather than trusted until a deploy
	# disagrees.
	log "reading the variables back"

	# Asked again, with a growing wait, before anything is called a mismatch.
	# GitHub's variable list lags a set by a few seconds: the first version
	# read it back at once, saw the value from before, and failed -- so every
	# changed variable took two runs of deploy-send-secrets, the second only
	# "working" because it sent a value GitHub had by then caught up with.
	# About fifteen seconds in all, which is well past the lag and short of
	# anybody wondering whether it has hung.
	local live wrong delay=1
	for attempt in 1 2 3 4 5; do
		live="$(gh variable list --json name,value -q '.[] | .name + "=" + .value' 2>/dev/null || true)"

		wrong=0
		for key in "${VAR_KEYS[@]}"; do
			[ -n "${!key:-}" ] || continue
			grep -qxF "$key=${!key}" <<<"$live" || wrong=$((wrong + 1))
		done

		[ "$wrong" -gt 0 ] && [ "$attempt" -lt 5 ] || break

		warn "GitHub has not caught up with $wrong variable(s) yet; asking again in ${delay}s"
		sleep "$delay"
		delay=$((delay * 2))
	done

	for key in "${VAR_KEYS[@]}"; do
		[ -n "${!key:-}" ] || continue
		if grep -qxF "$key=${!key}" <<<"$live"; then
			ok "$key is what we sent"
		else
			bad "$key came back different: sent $(shown "${!key}"), GitHub has $(shown "$(live_value "$key" "$live")")"
		fi
	done
	[ "$wrong" -eq 0 ] || die "$wrong variable(s) still differ after waiting for GitHub to catch up"
}

# ---------------------------------------------------------------- install

# cmd_install writes config.toml onto the server. Through a .new file and a
# rename, so the running binary never reads half a config.
#
# And only if the binary on the server accepts it. The binary refuses a key it
# does not know, so a config.toml carrying a setting from a newer release,
# installed under an older binary, is one the app cannot restart with: the
# watchdog's next start fails, and so does a rollback. Asking the binary with
# -check first makes that a refusal here, with nothing changed. On a first
# install there is no binary yet, and nothing to ask.
#
# The running process read its config when it started, so a new one takes
# effect at the next restart: make prod-restart.
cmd_install() {
	load
	require ssh

	materialise || die "the deploy credentials will not decode. Run: make deploy-status"
	[ -s "$(knownhosts)" ] || die "DEPLOY_KNOWN_HOSTS_B64 is empty; run make deploy-known-hosts first"

	local dir="${APP_DIR:?APP_DIR is not set}"
	local q; q="$(printf '%q' "$dir")"

	log "writing $dir/config.toml on ${DEPLOY_SSH_HOST}"

	local rendered; rendered="$(cmd_render production)"

	printf '%s\n' "$rendered" | remote "
		mkdir -p $q && chmod 700 $q && cd $q &&
		cat > config.toml.new && chmod 600 config.toml.new &&
		if [ -x ./reconcile ] && ! ./reconcile -config config.toml.new -check >/dev/null; then
			rm -f config.toml.new
			exit 3
		fi &&
		mv config.toml.new config.toml" \
	|| die "the app on the server refused the new config.toml (its reason is above), so the old one is still in place. Usually this means the release that understands the new settings has not deployed yet: merge it, let CI deploy it, and run this again"

	ok "installed. The app reads it when it next starts: make prod-restart"
}

# ---------------------------------------------------------------- dispatch

usage() {
	cat <<-USAGE
		usage: scripts/secrets <command>

		  status       is everything in place to deploy? secrets.env, GitHub,
		               the server, DNS and TLS, and the pipeline
		  check        the credentials half of status: secrets.env and GitHub
		  push         send the deploy group and the addresses to GitHub
		  install      write config.toml onto the server
		  render [production|local]
		               print a config.toml, write nothing
		  ssh-keygen   mint the deploy key and print how to install it
		  bootstrap-secret
		               print a fresh BOOTSTRAP_SIGNIN_SECRET
		  known-hosts  fetch the server's host key for pinning
	USAGE
}

case "${1:-}" in
status)      shift; cmd_status "$@" ;;
check)       shift; cmd_check "$@" ;;
push)        shift; cmd_push "$@" ;;
install)     shift; cmd_install "$@" ;;
render)      shift; cmd_render "$@" ;;
ssh-keygen)  shift; cmd_ssh_keygen "$@" ;;
bootstrap-secret) shift; cmd_bootstrap_secret "$@" ;;
known-hosts) shift; cmd_known_hosts "$@" ;;
*)           usage; exit 2 ;;
esac
