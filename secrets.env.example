# Every credential and address this project needs, in one file.
#
# Copy to secrets.env, fill it in, and keep that copy in Bitwarden.
# secrets.env is gitignored and must never be committed. This repository is
# public, so the hostname, the account and the paths live only there -- not
# in any tracked file. It holds the deploy key, base64-encoded -- encoded, not
# encrypted -- so it is exactly as sensitive as the key.
#
# The groups go to different places, and which group a value is in is a
# security decision, not a filing convenience:
#
#   DEPLOY_*   -> GitHub Actions *secrets*. CI needs them to reach the server.
#   APP_*      -> GitHub Actions *variables*. Hostnames and paths. Kept out
#                 of the tracked files, but not secret: the deploy prints
#                 them, and a public repository's Actions logs are public.
#   RUNTIME    -> the server's config.toml, over ssh, from your machine only.
#                 Never GitHub. None yet.
#
# In order:
#
#   make deploy-keygen          mint the key; install its public half on konsoleH
#   make deploy-known-hosts     pin the server's host key
#   make deploy-send-secrets    GitHub secrets and variables, and config.toml
#   make deploy-status          is everything in place? says what is not
#
# Then a push to main deploys.


# ---------------------------------------------------------------------------
# DEPLOY: how to reach the Hetzner konsoleH account. Becomes GitHub secrets.
# ---------------------------------------------------------------------------

# The same account as mass-intentions and stewards, so the same host and user.
# The key is this project's own: see make deploy-keygen.
DEPLOY_SSH_HOST=
DEPLOY_SSH_USER=
DEPLOY_SSH_PORT=22

# Paste the line make deploy-keygen prints.
DEPLOY_SSH_KEY_B64=

# Paste the line make deploy-known-hosts prints, after comparing the
# fingerprint with what konsoleH shows.
DEPLOY_KNOWN_HOSTS_B64=

# ---------------------------------------------------------------------------
# APP: where it lives. Becomes GitHub variables.
# ---------------------------------------------------------------------------

# The public hostname, such as reconcile.example.org. Add it in konsoleH as a
# subdomain with the docroot below, turn on Let's Encrypt for it, and point
# an A record at the server.
APP_HOST=

# The loopback port Apache proxies to. The binary's default and
# deploy/htaccess.template both say 8461; change all three or none.
# mass-intentions has 8431 and stewards 8451 on the same account.
APP_PORT=8461

# Where the binary, config.toml and (later) the database live, relative to the
# account's home. Must be OUTSIDE public_html: the deploy refuses one inside it.
APP_DIR=reconcile

# The docroot for APP_HOST, holding .htaccess and nothing else, such as
# public_html/reconcile.example.org/public
APP_DOCROOT=

# How many database backups to keep on the server. One is taken on every
# deploy, while the app is stopped, once there is a database.
KEEP_BACKUPS=14


# ---------------------------------------------------------------------------
# RUNTIME: rendered into the server's config.toml. NEVER sent to GitHub.
# ---------------------------------------------------------------------------

# None yet. The first one goes here, in RUNTIME_KEYS in scripts/secrets, and
# in that script's render.


# ---------------------------------------------------------------------------
# LOCAL: this machine only. Never leaves it. Read by: scripts/secrets render local
# ---------------------------------------------------------------------------

DEV_ADDR=127.0.0.1:8461
